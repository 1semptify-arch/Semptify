#!/bin/sh
# Git pre-commit hook: verify agent orchestrator files are in sync.
# Regeneration is manual (`python tools/sync_orchestrator.py`); CI and this
# hook only run `sync_orchestrator.py --check` and fail loudly if stale.
# Set as active with: git config core.hooksPath tools/hooks
set -e

./venv311/Scripts/python.exe tools/sync_orchestrator.py --check
