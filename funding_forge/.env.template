# Copy to .env and fill in before starting Funding Forge.
# Do not commit .env.

# Admin credentials (required for production). Falls back to Semptify ADMIN_* variables.
FUNDING_FORGE_ADMIN_USERNAME=admin
FUNDING_FORGE_ADMIN_PASSWORD=change-me  # pragma: allowlist secret
# FUNDING_FORGE_ADMIN_TOTP_SECRET=your-totp-secret

DATABASE_URL=sqlite+aiosqlite:///./funding_forge.db
UPLOADS_DIR=funding_forge/uploads
APP_HOST=127.0.0.1
APP_PORT=8001
DEBUG=false

# Storage backend: local or r2. When r2 is selected, uploads are persisted in
# Cloudflare R2. Local is the default for development.
FUNDING_FORGE_STORAGE_BACKEND=local

# Cloudflare R2 credentials (only required when STORAGE_BACKEND=r2).
# FUNDING_FORGE_R2_ACCOUNT_ID=your-account-id
# FUNDING_FORGE_R2_ACCESS_KEY_ID=your-access-key
# FUNDING_FORGE_R2_SECRET_ACCESS_KEY=your-secret-key
# FUNDING_FORGE_R2_BUCKET_NAME=your-bucket
# Optional custom endpoint; defaults to https://<account_id>.r2.cloudflarestorage.com
# FUNDING_FORGE_R2_ENDPOINT_URL=
