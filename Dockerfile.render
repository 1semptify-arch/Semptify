# =============================================================================
# Semptify FastAPI - Render MVP Dockerfile
# =============================================================================
# Render free-tier deployment image.
# Sets DEPLOY_TARGET=render_mvp by default so the app starts in minimal mode.
# To switch to the full feature set later, override DEPLOY_TARGET at the
# service level (e.g. render.yaml env var) without changing this file.
#
# Build: docker build -t semptify:render-mvp -f Dockerfile.render .
# Run:   docker run -p 8000:8000 --env-file .env semptify:render-mvp
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies
# -----------------------------------------------------------------------------
FROM python:3.11.9-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libpq-dev \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements first for better caching
COPY requirements-render-mvp.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-render-mvp.txt

# -----------------------------------------------------------------------------
# Stage 2: Runtime - Minimal production image
# -----------------------------------------------------------------------------
FROM python:3.11.9-slim

ARG DEPLOY_TARGET=render_mvp
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    DEPLOY_TARGET=${DEPLOY_TARGET}

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    libmagic1 \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user for security
RUN groupadd --gid 1000 semptify && \
    useradd --uid 1000 --gid semptify --shell /bin/bash --create-home semptify

# Copy application code
COPY --chown=semptify:semptify . .

# Create runtime directories and ensure the semptify user can write to /app
RUN mkdir -p uploads uploads/vault logs security data data/inventory && \
    chown -R semptify:semptify /app

# -----------------------------------------------------------------------------
# Bill Platform — embedded, so ONE Render service carries both apps inside the
# workspace's shared 750 free-instance-hours/month pool. Separate public repo
# (1semptify-arch/bill-platform — stdlib-only Python), baked in at build time.
# BILL_UPSTREAM switches on the FastAPI proxy routes for /bill*, /your-voice*,
# /what-the-bill-changes* in app/main.py. Its SQLite stays durable via the same
# Litestream→R2 setup the standalone bill-platform Render service uses (env
# vars LITESTREAM_ACCESS_KEY_ID / LITESTREAM_SECRET_ACCESS_KEY / R2_BUCKET /
# R2_ENDPOINT set on the Semptify service in the Render dashboard).
# -----------------------------------------------------------------------------
ARG BILL_REPO_REF=main
RUN curl -fsSL "https://codeload.github.com/1semptify-arch/bill-platform/tar.gz/refs/heads/${BILL_REPO_REF}" \
      | tar xz -C /opt \
    && mv "/opt/bill-platform-${BILL_REPO_REF}" /opt/bill-platform \
    && curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/v0.3.13/litestream-v0.3.13-linux-amd64.tar.gz" \
      | tar xz -C /opt/bill-platform \
    && chown -R semptify:semptify /opt/bill-platform

ENV BILL_MOUNT=/bill \
    BILL_UPSTREAM=http://127.0.0.1:8093

# Switch to non-root user
USER semptify

# Precompile Python bytecode so cold starts on Render's shared CPU skip
# per-file compilation. PYTHONDONTWRITEBYTECODE only blocks writing .pyc;
# the precompiled files are still read and used at runtime.
RUN python -m compileall -q /app/app

# Expose port (Render sets PORT env var, defaults to 8000)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Start command - uses $PORT env var for Render compatibility
# The embedded bill platform starts first in a background subshell (Litestream
# restore+replicate when R2 keys are present, plain server.py otherwise), bound
# to loopback only — it is reachable exclusively through the FastAPI proxy.
# --proxy-headers + --forwarded-allow-ips: all Render traffic arrives via their
# edge proxy; without these uvicorn sees http/<proxy-IP> instead of https/<client-IP>.
# The app already trusts X-Forwarded-For for rate limiting and jurisdiction, so
# trusting it at the ASGI layer changes no security assumption.
CMD ["sh", "-c", "(cd /opt/bill-platform && mkdir -p data && if [ -n \"$LITESTREAM_ACCESS_KEY_ID\" ]; then ./litestream restore -if-replica-exists -config litestream.yml ./data/platform.db; ./litestream replicate -config litestream.yml -exec 'python server.py --host 127.0.0.1 --port 8093'; else python server.py --host 127.0.0.1 --port 8093; fi) & exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips '*'"]
